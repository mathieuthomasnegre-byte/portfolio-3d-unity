/* Interface du portfolio : tons sourds, texte clair, un seul accent ambre. */

.root {
    flex-grow: 1;
    color: rgb(236, 232, 224);
    font-size: 22px;
}

.hidden {
    display: none;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Titre du chapitre */

.heading {
    position: absolute;
    left: 64px;
    top: 52px;
    max-width: 760px;
    opacity: 0;
    translate: 0 -12px;
    transition-property: opacity, translate;
    transition-duration: 0.6s;
}

.heading--show {
    opacity: 1;
    translate: 0 0;
}

.chapter {
    font-size: 17px;
    letter-spacing: 4px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.title {
    font-size: 46px;
    -unity-font-style: bold;
    white-space: normal;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
}

.subtitle {
    font-size: 22px;
    color: rgba(236, 232, 224, 0.82);
    white-space: normal;
    margin-top: 4px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
}

.signature {
    position: absolute;
    right: 64px;
    top: 58px;
    font-size: 19px;
    letter-spacing: 2px;
    color: rgba(236, 232, 224, 0.75);
    -unity-font-style: bold;
}

/* Fiche de l'étape */

.card {
    position: absolute;
    left: 64px;
    bottom: 150px;
    width: 520px;
    padding: 26px 30px 28px 30px;
    background-color: rgba(22, 24, 28, 0.78);
    border-radius: 16px;
    border-left-width: 4px;
    border-left-color: rgb(217, 178, 106);
    opacity: 0;
    translate: 0 24px;
    transition-property: opacity, translate;
    transition-duration: 0.45s;
}

.card--show {
    opacity: 1;
    translate: 0 0;
}

.card-step {
    font-size: 15px;
    letter-spacing: 3px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.card-title {
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 10px;
}

.card-body {
    font-size: 21px;
    color: rgba(236, 232, 224, 0.9);
    white-space: normal;
}

/* Bas d'écran : progression et action */

.footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 34px;
    align-items: center;
}

.dots {
    flex-direction: row;
    margin-bottom: 14px;
}

.dot {
    width: 34px;
    height: 5px;
    margin: 0 4px;
    border-radius: 3px;
    background-color: rgba(236, 232, 224, 0.28);
    transition-property: background-color;
    transition-duration: 0.4s;
}

.dot--done {
    background-color: rgb(217, 178, 106);
}

.hint {
    font-size: 15px;
    color: rgba(236, 232, 224, 0.55);
    margin-top: 10px;
}

.action {
    padding: 14px 34px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(28, 26, 22);
    background-color: rgb(217, 178, 106);
    border-width: 0;
    border-radius: 30px;
    margin: 0;
    transition-property: background-color, scale, opacity;
    transition-duration: 0.2s;
}

.action:hover {
    background-color: rgb(232, 198, 132);
    scale: 1.04 1.04;
}

.action:active {
    scale: 0.98 0.98;
}

.action--busy {
    opacity: 0;
}

.secondary {
    padding: 14px 30px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(236, 232, 224);
    background-color: rgba(236, 232, 224, 0.12);
    border-width: 1px;
    border-color: rgba(236, 232, 224, 0.4);
    border-radius: 30px;
    margin: 0 0 0 14px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.secondary:hover {
    background-color: rgba(236, 232, 224, 0.24);
}

.ghost {
    margin: 14px 0 0 0;
    padding: 6px 10px;
    font-size: 18px;
    color: rgba(236, 232, 224, 0.7);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ghost:hover {
    color: rgb(236, 232, 224);
}

/* Écrans d'accueil et de contact */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 15, 18, 0.62);
}

.panel {
    width: 760px;
    max-width: 90%;
    padding: 46px 52px;
    align-items: flex-start;
    background-color: rgba(22, 24, 28, 0.9);
    border-radius: 22px;
}

.kicker {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.hero {
    font-size: 64px;
    -unity-font-style: bold;
    white-space: normal;
}

.tagline {
    font-size: 26px;
    color: rgba(236, 232, 224, 0.85);
    margin-bottom: 18px;
    white-space: normal;
}

.paragraph {
    font-size: 22px;
    color: rgba(236, 232, 224, 0.88);
    white-space: normal;
    margin-bottom: 28px;
}

.links {
    flex-direction: row;
    flex-wrap: wrap;
}

.mail {
    font-size: 19px;
    color: rgba(236, 232, 224, 0.7);
    margin-top: 16px;
}
