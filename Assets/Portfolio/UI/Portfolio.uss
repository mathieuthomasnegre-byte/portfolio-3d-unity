/* Interface du portfolio : tons sourds, texte clair, un seul accent ambre. */

.root {
    flex-grow: 1;
    color: rgb(236, 232, 224);
    font-size: 22px;
}

.hidden {
    display: none;
}

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Titre du chapitre */

.heading {
    position: absolute;
    left: 64px;
    top: 48px;
    max-width: 760px;
    padding-left: 22px;
    border-left-width: 3px;
    border-left-color: rgb(217, 178, 106);
    opacity: 0;
    translate: -16px 0;
    transition-property: opacity, translate;
    transition-duration: 0.7s;
    transition-timing-function: ease-out-cubic;
}

.heading--show {
    opacity: 1;
    translate: 0 0;
}

.chapter {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 4px;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
}

.title {
    font-size: 46px;
    -unity-font-style: bold;
    white-space: normal;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
}

.subtitle {
    font-size: 21px;
    color: rgba(236, 232, 224, 0.86);
    white-space: normal;
    margin-top: 2px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);
}

/* Fil des trois chambres, en haut à droite */

.chapters {
    position: absolute;
    right: 64px;
    top: 54px;
    flex-direction: row;
    align-items: center;
    padding: 7px 6px;
    background-color: rgba(20, 22, 26, 0.6);
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(236, 232, 224, 0.13);
}

.chapter-pip {
    font-size: 16px;
    letter-spacing: 1px;
    padding: 6px 16px;
    margin: 0 2px;
    border-radius: 16px;
    color: rgba(236, 232, 224, 0.5);
    -unity-font-style: bold;
    transition-property: color, background-color;
    transition-duration: 0.6s;
}

.chapter-pip--done {
    color: rgba(236, 232, 224, 0.88);
}

.chapter-pip--current {
    color: rgb(28, 26, 22);
    background-color: rgb(217, 178, 106);
}

.signature {
    position: absolute;
    right: 70px;
    top: 112px;
    font-size: 15px;
    letter-spacing: 3px;
    color: rgba(236, 232, 224, 0.62);
    -unity-font-style: bold;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
}

/* Fiche de l'étape */

.card {
    position: absolute;
    left: 64px;
    bottom: 156px;
    width: 540px;
    padding: 26px 32px 30px 32px;
    background-color: rgba(20, 22, 26, 0.84);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(236, 232, 224, 0.13);
    border-top-width: 3px;
    border-top-color: rgb(217, 178, 106);
    opacity: 0;
    translate: 0 28px;
    scale: 0.98 0.98;
    transition-property: opacity, translate, scale;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
}

.card--show {
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.card-step {
    align-self: flex-start;
    font-size: 14px;
    letter-spacing: 3px;
    padding: 4px 12px;
    border-radius: 12px;
    color: rgb(217, 178, 106);
    background-color: rgba(217, 178, 106, 0.14);
    -unity-font-style: bold;
    margin-bottom: 12px;
}

.card-title {
    font-size: 31px;
    -unity-font-style: bold;
    white-space: normal;
    margin-bottom: 10px;
}

.card-body {
    font-size: 21px;
    color: rgba(236, 232, 224, 0.9);
    white-space: normal;
}

/* Bas d'écran : progression et action */

.footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    align-items: center;
}

.dots {
    flex-direction: row;
    margin-bottom: 14px;
}

.dot {
    width: 30px;
    height: 5px;
    margin: 0 4px;
    border-radius: 3px;
    background-color: rgba(236, 232, 224, 0.28);
    transition-property: background-color;
    transition-duration: 0.45s;
}

.dot--done {
    background-color: rgb(217, 178, 106);
}

.hint {
    font-size: 15px;
    color: rgba(236, 232, 224, 0.62);
    margin-top: 10px;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
    transition-property: color;
    transition-duration: 0.25s;
}

.hint--active {
    color: rgb(232, 198, 132);
}

.action {
    padding: 15px 38px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(28, 26, 22);
    background-color: rgb(217, 178, 106);
    border-width: 0;
    border-radius: 32px;
    margin: 0;
    transition-property: background-color, scale, opacity, translate;
    transition-duration: 0.25s;
}

.action:hover {
    background-color: rgb(232, 198, 132);
    scale: 1.05 1.05;
}

.action:active {
    scale: 0.97 0.97;
}

.action--busy {
    opacity: 0;
    translate: 0 10px;
}

.secondary {
    padding: 14px 30px;
    font-size: 23px;
    -unity-font-style: bold;
    color: rgb(236, 232, 224);
    background-color: rgba(236, 232, 224, 0.1);
    border-width: 1px;
    border-color: rgba(236, 232, 224, 0.4);
    border-radius: 32px;
    margin: 0 0 0 14px;
    transition-property: background-color;
    transition-duration: 0.2s;
}

.secondary:hover {
    background-color: rgba(236, 232, 224, 0.24);
}

.ghost {
    margin: 14px 0 0 0;
    padding: 6px 10px;
    font-size: 18px;
    color: rgba(236, 232, 224, 0.7);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ghost:hover {
    color: rgb(236, 232, 224);
}

/* Écrans d'accueil et de contact */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(14, 15, 18, 0.6);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.6s;
}

.overlay--out {
    opacity: 0;
}

.panel {
    width: 780px;
    max-width: 90%;
    padding: 48px 56px;
    align-items: flex-start;
    background-color: rgba(20, 22, 26, 0.92);
    border-radius: 24px;
    border-width: 1px;
    border-color: rgba(236, 232, 224, 0.13);
    border-top-width: 3px;
    border-top-color: rgb(217, 178, 106);
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
}

.overlay--out .panel {
    translate: 0 26px;
    scale: 0.97 0.97;
}

.kicker {
    font-size: 16px;
    letter-spacing: 5px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.hero {
    font-size: 66px;
    -unity-font-style: bold;
    white-space: normal;
}

.tagline {
    font-size: 26px;
    color: rgba(236, 232, 224, 0.85);
    margin-bottom: 18px;
    white-space: normal;
}

.paragraph {
    font-size: 22px;
    color: rgba(236, 232, 224, 0.88);
    white-space: normal;
    margin-bottom: 28px;
}

.links {
    flex-direction: row;
    flex-wrap: wrap;
}

.mail {
    font-size: 19px;
    color: rgba(236, 232, 224, 0.7);
    margin-top: 16px;
}

/* Passage d'une chambre à l'autre */

.interlude {
    position: absolute;
    left: 0;
    right: 0;
    top: 38%;
    align-items: center;
    opacity: 0;
    translate: 0 18px;
    transition-property: opacity, translate;
    transition-duration: 0.9s;
}

.interlude--show {
    opacity: 1;
    translate: 0 0;
}

.interlude-kicker {
    font-size: 18px;
    letter-spacing: 6px;
    color: rgb(217, 178, 106);
    -unity-font-style: bold;
    margin-bottom: 10px;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
}

.interlude-title {
    font-size: 68px;
    -unity-font-style: bold;
    text-shadow: 0 3px 16px rgba(0, 0, 0, 0.55);
}
